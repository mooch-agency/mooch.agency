{
  "_readme": "Discovery search tiers for /creditcards. Every term here must appear in docs/credits-glossary.md (checked by scripts/creditcards-search.test.mjs). Queries are built by scripts/creditcards-search.mjs: (any) AND (all groups) AND each operator AND NOT each exclude. Caps are posts per request; maxPages bounds pagination inside one since_id window. schedule 'every' runs on both daily slots, 'morning' only on the first run of the UTC day. Not wired into creditcards-update.mjs yet.",
  "glossary": "docs/credits-glossary.md",
  "noise": {
    "_readme": "Excluded from every tier that does not anchor on Jack, and scored down everywhere.",
    "exclude": [
      "gmgn",
      "dexscreener",
      "\"statement credit\"",
      "\"statement credits\"",
      "cashback",
      "\"cash back\"",
      "amex",
      "fico",
      "mentorship"
    ]
  },
  "tiers": [
    {
      "id": "anchor",
      "label": "A: anchored on Jack, jack.art, the contract or the OpenSea slug",
