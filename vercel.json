{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/log", "destination": "/", "permanent": true },
    { "source": "/ready", "destination": "/", "permanent": true },
    { "source": "/contrabando", "destination": "/lisbon-restaurant-group", "permanent": true },
    { "source": "/contrabando.html", "destination": "/lisbon-restaurant-group", "permanent": true },
    { "source": "/audit", "destination": "/#audit", "permanent": true },
    { "source": "/og.jpg", "destination": "/og-image.png?v=ddc41f4f", "permanent": true },
    { "source": "/og-ready.png", "destination": "/og-image.png?v=ddc41f4f", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Link",
          "value": "</llms.txt>; rel=\"describedby\"; type=\"text/plain\", </.well-known/agent-skills/index.json>; rel=\"agent-skills\"; type=\"application/json\", </sitemap.xml>; rel=\"sitemap\"; type=\"application/xml\""
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://*.vercel-scripts.com https://*.vercel-insights.com https://*.vercel-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://*.vercel-insights.com https://*.vercel-analytics.com; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "functions": {
    "api/rewrite.js": { "includeFiles": "api/pg-system.md" },
    "api/say-less.js": { "maxDuration": 60 },
    "api/deslop.js": { "includeFiles": "prompts/deslop.html", "maxDuration": 120 }
  }
}
